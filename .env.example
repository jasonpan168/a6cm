# 数据库配置
# 支持 SQLite（自动检测 database.db）或 MySQL
DB_HOST=localhost
DB_NAME=dwz
DB_USER=dwz
DB_PASSWORD=your_secure_password

# 邮件配置（用于注册验证等）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=短网址服务

# 二维码配置
# 默认（留空或整行删掉）= 用仓库自带的 phpqrcode 库在本地生成，不联网、不泄露短链接。
# 只有在你确实想改用某个远程二维码接口时才填写；填写后每次生成都会把完整短链接
# 发送给该第三方服务。
# QR_CODE_API=https://api.pwmqr.com/qrcode/create/?url=

# 源代码获取地址（AGPL-3.0 第 13 条）
# 留空 = 指向上游原始仓库。
# 如果你修改了本项目并对外提供网络服务，AGPL 要求你向用户提供**你实际运行的**
# 那份源代码，请把下面这行指向你自己的仓库。
# SOURCE_CODE_URL=https://github.com/你的账号/你的仓库

# 目标域名黑名单（可选）：逗号分隔，与根目录 blacklist.txt 取并集。
# 创建 / 编辑短链接时，目标域名命中即拒绝。默认留空 = 不拦截。
# URL_BLACKLIST=malware-example.test,phishing-example.test

# 登录防爆破（可选，默认值如下）
# LOGIN_MAX_ATTEMPTS=5        # 连续失败多少次后锁定
# LOGIN_LOCK_SECONDS=900      # 锁定时长（秒），默认 15 分钟
# LOGIN_WINDOW_SECONDS=900    # 失败计数窗口（秒）

# 仅当 PHP 确实在你自己的反向代理后面时才设为 1（否则 X-Forwarded-For 可被伪造）
# TRUSTED_PROXY=1
